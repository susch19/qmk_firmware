{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make keychron/v5_max/iso_encoder:susch -j 14 && cp .build/keychron_v5_max_iso_encoder_susch.bin firmwares/keychron_v5_max_iso_encoder_susch_$(date +\"%Y_%m_%d.%H_%M_%S\").bin",
            //qmk compile -kb keychron/v5_max/iso_encoder/ -km susch -j 0
            //make -j 14 keychron/v5_max/iso_encoder:susch
            "args": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "c",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+): (warning|error): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
